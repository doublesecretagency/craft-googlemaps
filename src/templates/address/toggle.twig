<span class="map-toggle-container">
  <button
      type="button"
      class="map-toggle"
      data-gm-toggle
  >
    <span
        class="map-toggle-text"
        data-gm-toggle-text
    >
      Toggle Map
    </span>
    <img
        class="map-toggle-icon"
        data-gm-toggle-icon
        alt="Toggle Map"
    />
  </button>
</span>

{% css %}
[data-gm-address-root] {
    position: relative;
}
.map-toggle-container {
    position: absolute;
    top: -27px;
    right: 4px;
    opacity: 0;
    pointer-events: none;
    transition: opacity .07s ease-in-out;
}
.map-toggle-container.is-hydrated {
    opacity: 1;
    pointer-events: auto;
}
.map-toggle {
    cursor: pointer;
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
}
.map-toggle-icon {
    display: inline-block;
    height: 14px;
    margin-left: 5px;
    margin-bottom: -2px;
}
{% endcss %}
