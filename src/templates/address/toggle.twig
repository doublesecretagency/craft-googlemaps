{% if 'hidden' != config.settings.visibilityToggle %}
    <teleport to="#{{ config.namespace.id }}-field .heading">
        <span
            class="map-toggle-container"
            data-gm-field="{{ config.namespace.id }}"
        >
          <button
              type="button"
              class="map-toggle"
              data-gm-toggle
              data-gm-field="{{ config.namespace.id }}"
          >
            <span
                class="map-toggle-text"
                data-gm-toggle-text
            >
              Toggle Map
            </span>
            <img
                class="map-toggle-icon"
                data-gm-toggle-icon
                alt="Toggle Map"
            />
          </button>
        </span>
    </teleport>
{% endif %}

{% css %}
.map-toggle-container {
    opacity: 0;
    pointer-events: none;
    transition: opacity .07s ease-in-out;
}
.map-toggle-container.is-hydrated {
    opacity: 1;
    pointer-events: auto;
}
.map-toggle {
    text-align: right;
    cursor: pointer;
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
}
.map-toggle-icon {
    display: inline-block;
    height: 14px;
    margin-left: 5px;
    margin-right: 1px;
    margin-bottom: 2px;
}
{% endcss %}
