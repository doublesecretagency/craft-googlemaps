{# Get subfields from PHP settings #}
{% set subfields = (config.settings.subfieldConfig ?? []) %}

<div class="field">
    <div class="heading">
        <label>Subfield Manager</label>
        <div class="instructions">
            <p>Rename, resize, rearrange, require, or hide each subfield...</p>
        </div>
    </div>

    <div>
        <table class="editable fullwidth gm-subfields">
            <thead>
            <tr>
                <th scope="col" class="singleline-cell textual">Label</th>
                <th scope="col" class="number-cell textual" style="text-align:right">Width</th>
                <th scope="col" class="checkbox-cell" style="text-align:center; cursor:help;"
                    title="Selected subfields will be shown in the visible layout. (Non-selected subfields will be included as hidden inputs.)">
                    Show
                </th>
                <th scope="col" class="checkbox-cell" style="text-align:center; cursor:help;"
                    title="When typing an address, Google Places Autocomplete will be active on the selected subfields.">
                    Auto
                </th>
                <th scope="col" class="checkbox-cell" style="text-align:center; cursor:help; white-space:nowrap;"
                    title="If the field is marked as &quot;Required&quot;, it must include the selected subfields. See warning message below.">
                    Req.<span class="required" aria-hidden="true"></span>
                </th>
                <th>&nbsp;</th>
            </tr>
            </thead>

            <tbody>

                {# Loop over all subfields #}
                {% for i, sf in subfields %}

                    {# Unique suffix for label associations #}
                    {% set r = random() %}

                    <tr data-gm-subfield-row data-key="{{ sf.handle }}" data-handle="{{ sf.handle }}" data-index="{{ i }}" class="{{ sf.enabled is defined and not sf.enabled ? 'disabled' }}">
                        <td class="singleline-cell textual">
                            <input
                                type="hidden"
                                name="{{ "subfieldConfig[#{i}][handle]" }}"
                                value="{{ sf.handle }}"
                            >
                            <textarea
                                name="{{ "subfieldConfig[#{i}][label]" }}"
                                rows="1"
                                style="min-height:34px;"
                                placeholder="{{ sf.handle }}"
                            >{{ sf.label ?? '' }}</textarea>
                        </td>

                        <td class="textual code" style="width:15%; text-align:right;">
                            <input
                                type="number"
                                name="{{ "subfieldConfig[#{i}][width]" }}"
                                value="{{ sf.width ?? 100 }}"
                                style="min-height:34px; max-width:60px; text-align:right; border:none;"
                            >
                        </td>

                        {# Show (enabled) checkbox #}
                        <td class="checkbox-cell" style="width:15%; text-align:center;">
                            <div class="checkbox-wrapper">
                                <input type="hidden"
                                       name="{{ "subfieldConfig[#{i}][enabled]" }}"
                                       value="0">
                                <input type="checkbox"
                                       id="enabled-{{ sf.handle }}-{{ r }}"
                                       class="checkbox"
                                       name="{{ "subfieldConfig[#{i}][enabled]" }}"
                                       value="1"
                                    {{ (sf.enabled ?? true) ? 'checked' }}>
                                <label for="enabled-{{ sf.handle }}-{{ r }}"></label>
                            </div>
                        </td>

                        {# Auto (autocomplete) checkbox #}
                        <td class="checkbox-cell" style="width:15%; text-align:center;">
                            <div class="checkbox-wrapper">
                                <input type="hidden"
                                       name="{{ "subfieldConfig[#{i}][autocomplete]" }}"
                                       value="0">
                                <input type="checkbox"
                                       id="autocomplete-{{ sf.handle }}-{{ r }}"
                                       class="checkbox"
                                       name="{{ "subfieldConfig[#{i}][autocomplete]" }}"
                                       value="1"
                                    {{ (sf.autocomplete ?? false) ? 'checked' }}>
                                <label for="autocomplete-{{ sf.handle }}-{{ r }}"></label>
                            </div>
                        </td>

                        {# Required checkbox #}
                        <td class="checkbox-cell" style="width:15%; text-align:center;">
                            <div class="checkbox-wrapper">
                                <input type="hidden"
                                       name="{{ "subfieldConfig[#{i}][required]" }}"
                                       value="0">
                                <input type="checkbox"
                                       id="required-{{ sf.handle }}-{{ r }}"
                                       class="checkbox"
                                       name="{{ "subfieldConfig[#{i}][required]" }}"
                                       value="1"
                                    {{ (sf.required ?? false) ? 'checked' }}>
                                <label for="required-{{ sf.handle }}-{{ r }}"></label>
                            </div>
                        </td>

                        <td class="thin action">
                            <a class="move icon" title="Reorder"></a>
                        </td>
                    </tr>
                {% endfor %}

            </tbody>
        </table>
    </div>
</div>
