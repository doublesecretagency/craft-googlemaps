<script>
// Suppress console logging for hidden map
window._gmData.logging = false;

// Delay the success message
let successTimeout;

// Display the status of an API service
function gm_setStatus(id, state, label, detail) {
    // Get the status cell and the matching template
    const cell = document.getElementById(id);
    const template = document.getElementById(`gm-status-template-${state}`);
    // Replace the status
    cell.innerHTML = template.innerHTML;
    cell.querySelector('.gm-status-label').textContent = label;
    // If details were provided, show them
    if (detail) {
        const p = cell.querySelector('.gm-status-detail');
        p.innerHTML = detail;
        p.hidden = false;
    }
}

// Test Places API (New), and whether the legacy Places API is still in use
async function gm_testPlaces() {
    try {
        // Request suggestions from Places API (New)
        const {AutocompleteSuggestion} = await google.maps.importLibrary('places');
        await AutocompleteSuggestion.fetchAutocompleteSuggestions({input: 'usa'});
        // Success
        gm_setStatus('gm-status-places', 'valid', 'Working');
    } catch (error) {
        // Check whether the legacy Places API still works
        const legacy = await new Promise(resolve => {
            try {
                new google.maps.places.AutocompleteService().getPlacePredictions({input: 'usa'}, (p, status) => resolve('OK' === status));
            } catch (e) {
                resolve(false);
            }
            setTimeout(() => resolve(false), 8000);
        });
        // Display the results
        if (legacy) {
            gm_setStatus('gm-status-places', 'legacy', 'Using legacy API', 'Address autocompletion still works, using the legacy Places API, which is deprecated. Enable Places API (New) to keep it working.');
        } else {
            gm_setStatus('gm-status-places', 'invalid', 'Not working', 'Address autocompletion will not work until Places API (New) is enabled.');
        }
    }
}

// 1. Fired every time the API connects
function gm_authSuccess() {
    // Whether the browser key exists (via Twig)
    const browserKeyExists = {{ googleMaps.browserKey ? 'true' : 'false' }};
    // If the browser key is missing
    if (!browserKeyExists) {
        // Show the error message
        gm_authFailure(`No browser key provided. For more information, see <a href="https://plugins.doublesecretagency.com/google-maps/getting-started/api-keys/" target="_blank">the documentation...</a>`);
        // Bail
        return;
    }
    // Stall success message, in case it actually fails
    successTimeout = setTimeout(() => {
        console.log('[GM] Browser key authentication successful ✅');
        // Display status message
        gm_setStatus('gm-status-maps-js', 'valid', 'Working');
        // Test the Places API
        gm_testPlaces();
    }, 1000);
}

// 2. Additionally fired when the API key fails
function gm_authFailure(message) {
    console.log('[GM] Browser key authentication failed ❌');
    // Stop success message
    clearTimeout(successTimeout);
    // Display status messages
    gm_setStatus('gm-status-maps-js', 'invalid', 'Not working', ('string' === typeof message) ? message : 'The browser key is not valid.');
    gm_setStatus('gm-status-places', 'invalid', 'Not working', 'Requires a working browser key.');
}
</script>

{# Load required JavaScript files, then trigger the callback #}
{% do googleMaps.loadAssets({'callback': 'gm_authSuccess'}) %}

{# Hidden map to trigger API test #}
{{ googleMaps.map({'lat':0,'lng':0}, {'id':'test-browser-key'}).tag({'assets': false}) }}
